# Supabase browser-safe project configuration (public key only)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
# Older Supabase projects may use the anon key instead:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Production: comma-separated emails allowed to use the app
ALLOWED_AGENT_EMAILS=agent1@example.com

# Select one server-side vehicle API provider: surepass (default) or eko.
VEHICLE_PROVIDER=surepass
APP_MODE=sandbox

# Surepass RC V2: use the sandbox URL only for development/preview.
VEHICLE_API_BASE_URL=https://sandbox.surepass.app/api/v1
VEHICLE_API_KEY=your_surepass_sandbox_token

# Eko Vehicle & RC UAT (set VEHICLE_PROVIDER=eko after Eko issues credentials).
# UAT defaults to https://staging.eko.in/ekoapi/v3; only set this to an official URL from Eko.
EKO_API_BASE_URL=https://staging.eko.in/ekoapi/v3
EKO_DEVELOPER_KEY=your_eko_uat_developer_key
EKO_ACCESS_KEY=your_eko_uat_access_key
EKO_INITIATOR_ID=your_registered_eko_mobile_number

# Durable, shared per-user lookup limits
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Production rules:
# - Set APP_MODE=production
# - Set the official live Surepass base URL confirmed by Surepass
# - Set the live credential in VEHICLE_API_KEY
# - Keep VEHICLE_API_KEY and UPSTASH tokens server-side (never NEXT_PUBLIC_*)
# - Configure variables in the Vercel Production environment, not in Git

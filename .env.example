# Surepass provider (use sandbox values for local development only)
VEHICLE_API_BASE_URL=https://sandbox.surepass.app/api/v1
VEHICLE_API_KEY=your_surepass_bearer_token_here
VEHICLE_API_TOKEN=
APP_MODE=sandbox

# Supabase Auth. These are the project URL and PUBLIC publishable/anon key.
# Never put a service-role key in a NEXT_PUBLIC_* variable.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
# Older Supabase projects may use the anon key instead:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Durable per-user RC lookup limits (required in production)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Production deployment requirements:
# 1. Use the official LIVE Surepass API base URL provided for your account.
# 2. Set APP_MODE=production.
# 3. Do not use a sandbox hostname or leave the provider URL unset.
# 4. Configure all Supabase and Upstash values in the hosting provider's
#    environment settings, not in source control.

# Copy this file to .env.local and fill in real values for your environment.
VEHICLE_API_BASE_URL=https://sandbox.surepass.app/api/v1
VEHICLE_API_KEY=your_surepass_api_key_here
VEHICLE_API_TOKEN=
VEHICLE_API_SECRET=
VEHICLE_API_USERNAME=
VEHICLE_API_PASSWORD=
APP_MODE=sandbox

# Example request pattern from the Surepass RC V2 API docs:
# curl --location 'https://sandbox.surepass.app/api/v1/rc/rc-v2' \
#   --header 'Content-Type: application/json' \
#   --header 'Authorization: Bearer <YOUR_TOKEN>' \
#   --data-raw '{ "id_number":"DL08AB1234", "enrich": false }'

# Do not commit real credentials or secrets to version control.

# Server-only sandbox settings. Never use NEXT_PUBLIC_ for API secrets.
# Set these locally in .env.local or in your hosting provider's secret manager.
VEHICLE_API_BASE_URL=https://sandbox.example.invalid
VEHICLE_API_KEY=
# Fill in the exact paths from your provider's API documentation.
VEHICLE_API_RC_V2_PATH=
VEHICLE_API_RC_TEXT_PATH=
VEHICLE_API_OCR_RC_PATH=

# Future Supabase configuration (not required for demo mode yet)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
